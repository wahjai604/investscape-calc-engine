{
  "name": "investscape-calc-engine",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/umd/investscape-calc-engine.umd.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "unpkg": "./dist/umd/investscape-calc-engine.umd.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/umd/investscape-calc-engine.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "directories": {
    "test": "__tests__"
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:esm && npm run build:umd",
    "build:esm": "tsc --project tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}, null, 2))\" && node scripts/fix-esm-extensions.mjs",
    "build:umd": "webpack --config webpack.config.js --mode production",
    "build:clean": "rimraf dist/",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@formulajs/formulajs": "^4.6.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.4.4",
    "typescript": "^5.9.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  }
}
